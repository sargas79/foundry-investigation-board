{{!-- Case title, status and progress. Made editable in milestone 5 (#29, #30). --}}
<header class="ib-header">
    <div class="ib-header-titles">
        <h1 class="ib-case-title">
            {{#if hasCase}}{{currentCase.name}}{{else}}{{localize "INVESTIGATION_BOARD.NoCaseOpen"}}{{/if}}
        </h1>
        {{#if hasCase}}
            <p class="ib-case-status">
                {{localize "INVESTIGATION_BOARD.StatusLabel"}}
                <span class="ib-status-value" data-status="{{state.status}}">
                    {{localize state.statusLabel}}
                </span>
                {{#if state.classification}}
                    <span class="ib-case-classification">{{state.classification}}</span>
                {{/if}}
            </p>
        {{/if}}
    </div>

    {{#if hasCase}}
        <div class="ib-progress" data-tooltip="{{localize 'INVESTIGATION_BOARD.ProgressTooltip'}}">
            <div class="ib-progress-track">
                <div class="ib-progress-fill" style="width: {{state.progress}}%"></div>
            </div>
            <span class="ib-progress-value">{{state.progress}}%</span>
        </div>
    {{/if}}

    <button type="button" class="ib-icon-button ib-settings" data-action="toggleMaximize"
            data-tooltip="INVESTIGATION_BOARD.ToggleMaximize"
            aria-label="{{localize 'INVESTIGATION_BOARD.ToggleMaximize'}}">
        <i class="fa-solid fa-expand"></i>
    </button>
</header>
