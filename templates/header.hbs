{{!-- Case title, status and progress. Made editable in milestone 5 (#29, #30). --}}
<header class="ib-header">
    <div class="ib-header-titles">
        <h1 class="ib-case-title">
            {{#if hasCase}}{{currentCase.name}}{{else}}{{localize "INVESTIGATION_BOARD.NoCaseOpen"}}{{/if}}
        </h1>
        {{#if hasCase}}
            <p class="ib-case-status">
                {{localize "INVESTIGATION_BOARD.StatusLabel"}}
                <span class="ib-status-value" data-status="{{state.status}}">
                    {{localize state.statusLabel}}
                </span>
                {{#if state.classification}}
                    <span class="ib-case-classification">{{state.classification}}</span>
                {{/if}}
            </p>
        {{/if}}
    </div>

    {{#if hasCase}}
        <div class="ib-progress {{#if currentCase.isOwner}}editable{{/if}}"
             data-tooltip="{{localize 'INVESTIGATION_BOARD.ProgressTooltip'}}">
            {{!-- A real range input: keyboard-operable and draggable for free. --}}
            {{#if currentCase.isOwner}}
                <input type="range" class="ib-progress-input" min="0" max="100" step="1"
                       value="{{state.progress}}"
                       aria-label="{{localize 'INVESTIGATION_BOARD.ProgressLabel'}}"
                       style="--ib-progress: {{state.progress}}%">
            {{else}}
                <div class="ib-progress-track">
                    <div class="ib-progress-fill" style="width: {{state.progress}}%"></div>
                </div>
            {{/if}}
            <span class="ib-progress-value">{{state.progress}}%</span>
        </div>
    {{/if}}

    <div class="ib-header-actions">
        {{#if hasCase}}
            {{#if canShare}}
                <button type="button" class="ib-icon-button" data-action="shareCase"
                        data-case-id="{{currentCase.id}}"
                        data-tooltip="INVESTIGATION_BOARD.DIALOG.Share"
                        aria-label="{{localize 'INVESTIGATION_BOARD.DIALOG.Share'}}">
                    <i class="fa-solid fa-user-group"></i>
                </button>
            {{/if}}
            {{#if currentCase.isOwner}}
                <button type="button" class="ib-icon-button" data-action="archiveCase"
                        data-case-id="{{currentCase.id}}"
                        data-tooltip="{{#if state.archived}}{{localize 'INVESTIGATION_BOARD.Reopen'}}{{else}}{{localize 'INVESTIGATION_BOARD.Archive'}}{{/if}}"
                        aria-label="{{#if state.archived}}{{localize 'INVESTIGATION_BOARD.Reopen'}}{{else}}{{localize 'INVESTIGATION_BOARD.Archive'}}{{/if}}">
                    <i class="fa-solid {{#if state.archived}}fa-box-open{{else}}fa-box-archive{{/if}}"></i>
                </button>
            {{/if}}
            {{!-- Players close a case; only the GM can destroy one. --}}
            {{#if isGM}}
                <button type="button" class="ib-icon-button ib-danger" data-action="deleteCase"
                        data-case-id="{{currentCase.id}}"
                        data-tooltip="INVESTIGATION_BOARD.DeleteCase"
                        aria-label="{{localize 'INVESTIGATION_BOARD.DeleteCase'}}">
                    <i class="fa-solid fa-trash"></i>
                </button>
            {{/if}}
            <button type="button" class="ib-icon-button" data-action="configureCase"
                    data-case-id="{{currentCase.id}}"
                    data-tooltip="INVESTIGATION_BOARD.CaseDetails"
                    aria-label="{{localize 'INVESTIGATION_BOARD.CaseDetails'}}">
                <i class="fa-solid fa-gear"></i>
            </button>
        {{/if}}
        <button type="button" class="ib-icon-button" data-action="toggleMaximize"
                data-tooltip="INVESTIGATION_BOARD.ToggleMaximize"
                aria-label="{{localize 'INVESTIGATION_BOARD.ToggleMaximize'}}">
            <i class="fa-solid fa-expand"></i>
        </button>
    </div>
</header>
