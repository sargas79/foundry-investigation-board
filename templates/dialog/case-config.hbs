<div class="ib-case-config">

    <div class="form-group">
        <label for="ib-case-name">{{localize "INVESTIGATION_BOARD.CaseNameLabel"}}</label>
        <div class="form-fields">
            <input type="text" id="ib-case-name" name="name" value="{{name}}" required autofocus>
        </div>
    </div>

    <div class="form-group">
        <label for="ib-case-classification">{{localize "INVESTIGATION_BOARD.ClassificationLabel"}}</label>
        <div class="form-fields">
            {{!-- A datalist, not a select: the list is a suggestion and a table may use its own. --}}
            <input type="text" id="ib-case-classification" name="classification"
                   value="{{state.classification}}" list="ib-classification-options"
                   placeholder="{{localize 'INVESTIGATION_BOARD.ClassificationPlaceholder'}}">
            <datalist id="ib-classification-options">
                {{#each classifications}}
                    <option value="{{this}}"></option>
                {{/each}}
            </datalist>
        </div>
    </div>

    <div class="form-group">
        <label for="ib-case-status">{{localize "INVESTIGATION_BOARD.StatusLabel"}}</label>
        <div class="form-fields">
            <select id="ib-case-status" name="status">
                {{selectOptions statuses selected=state.status valueAttr="value" labelAttr="label"}}
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="ib-case-progress">{{localize "INVESTIGATION_BOARD.ProgressLabel"}}</label>
        <div class="form-fields ib-progress-field">
            <input type="range" id="ib-case-progress" name="progress"
                   min="0" max="100" step="1" value="{{state.progress}}"
                   oninput="this.nextElementSibling.value = this.value">
            <output>{{state.progress}}</output><span class="ib-percent">%</span>
        </div>
        <p class="hint">{{localize "INVESTIGATION_BOARD.ProgressHint"}}</p>
    </div>

</div>
