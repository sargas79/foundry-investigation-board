{{!-- No name field here. Core's `page-header.hbs`, included by these sheets as
      `super.EDIT_PARTS.header`, already renders one. A second input with the same name makes
      `form.elements.namedItem("name")` a RadioNodeList, which FormDataExtended reads as an
      *array* of both values — so saving wrote "Old,New" and doubled the title on every edit. --}}
<section class="ib-handout-page-edit">

    <div class="form-group">
        <label for="{{rootId}}-issuer">{{localize "INVESTIGATION_BOARD.HandoutIssuerLabel"}}</label>
        <div class="form-fields">
            <input type="text" id="{{rootId}}-issuer" name="system.issuer" value="{{handout.issuer}}">
        </div>
    </div>

    <div class="form-group">
        <label for="{{rootId}}-reference">{{localize "INVESTIGATION_BOARD.HandoutReferenceLabel"}}</label>
        <div class="form-fields">
            <input type="text" id="{{rootId}}-reference" name="system.reference"
                   value="{{handout.reference}}">
        </div>
    </div>

    <div class="form-group">
        <label for="{{rootId}}-dateline">{{localize "INVESTIGATION_BOARD.HandoutDatelineLabel"}}</label>
        <div class="form-fields">
            <input type="text" id="{{rootId}}-dateline" name="system.dateline"
                   value="{{handout.dateline}}">
        </div>
    </div>

    {{#if handout.rows.length}}
        <fieldset class="ib-handout-rows-edit">
            <legend>{{localize "INVESTIGATION_BOARD.HandoutRowsLabel"}}</legend>
            {{#each handout.rows}}
                <div class="ib-row-edit">
                    <input type="text" name="system.rows.{{@index}}.label" value="{{this.label}}"
                           class="ib-row-label"
                           aria-label="{{localize 'INVESTIGATION_BOARD.HandoutRowLabel'}}">
                    <input type="text" name="system.rows.{{@index}}.value" value="{{this.value}}"
                           class="ib-row-value"
                           aria-label="{{localize 'INVESTIGATION_BOARD.HandoutRowValue'}}">
                </div>
            {{/each}}
            {{!-- Adding and removing lines needs buttons a plain document form has nowhere to
                  put, so that stays with the dialog on the board. --}}
            <p class="hint">{{localize "INVESTIGATION_BOARD.HandoutRowsSheetHint"}}</p>
        </fieldset>
    {{/if}}

    <div class="form-group">
        <label for="{{rootId}}-image">{{localize "INVESTIGATION_BOARD.ImageLabel"}}</label>
        <div class="form-fields">
            <file-picker id="{{rootId}}-image" type="image" name="system.image"
                         value="{{handout.image}}"></file-picker>
        </div>
    </div>

    <div class="form-group stacked">
        <label for="{{rootId}}-body">{{localize "INVESTIGATION_BOARD.HandoutBodyLabel"}}</label>
        <prose-mirror id="{{rootId}}-body" name="system.body" value="{{handout.body}}"
                      toggled></prose-mirror>
    </div>

</section>
