{{!-- `name` comes from JournalEntryPageSheet's context; there is no `page` key. --}}
<section class="ib-connection-page-view">
    <h2>{{name}}</h2>
    <p class="ib-connection-summary">
        <strong>{{fromName}}</strong>
        <i class="fa-solid fa-arrows-left-right"></i>
        <strong>{{toName}}</strong>
    </p>
    {{#if connection.label}}
        <p class="ib-connection-label">{{connection.label}}</p>
    {{/if}}
</section>
