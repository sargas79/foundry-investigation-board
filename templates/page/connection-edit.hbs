<section class="ib-connection-page-edit">
    <p class="notification info">
        {{localize "INVESTIGATION_BOARD.ConnectionEditHint"}}
    </p>

    <div class="form-group">
        <label for="{{id}}-label">{{localize "INVESTIGATION_BOARD.ConnectionLabel"}}</label>
        <div class="form-fields">
            <input type="text" id="{{id}}-label" name="system.label" value="{{connection.label}}">
        </div>
    </div>

    <div class="form-group">
        <label>{{localize "INVESTIGATION_BOARD.ConnectionEnds"}}</label>
        <div class="form-fields">
            <span>{{fromName}} &harr; {{toName}}</span>
        </div>
    </div>
</section>
