<section class="ib-clue-page-edit">
    <div class="form-group">
        <label for="{{id}}-name">{{localize "Name"}}</label>
        <div class="form-fields">
            <input type="text" id="{{id}}-name" name="name" value="{{page.name}}">
        </div>
    </div>

    <div class="form-group">
        <label for="{{id}}-template">{{localize "INVESTIGATION_BOARD.TemplateLabel"}}</label>
        <div class="form-fields">
            <select id="{{id}}-template" name="system.template">
                {{selectOptions templateChoices selected=clue.template}}
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="{{id}}-category">{{localize "INVESTIGATION_BOARD.CategoryLabel"}}</label>
        <div class="form-fields">
            <select id="{{id}}-category" name="system.category">
                {{selectOptions categoryChoices selected=clue.category}}
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="{{id}}-reliability">{{localize "INVESTIGATION_BOARD.ReliabilityLabel"}}</label>
        <div class="form-fields">
            <select id="{{id}}-reliability" name="system.reliability">
                {{selectOptions reliabilityChoices selected=clue.reliability}}
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="{{id}}-image">{{localize "INVESTIGATION_BOARD.ImageLabel"}}</label>
        <div class="form-fields">
            <file-picker type="image" name="system.image" value="{{clue.image}}"></file-picker>
        </div>
    </div>

    <div class="form-group stacked">
        <label>{{localize "INVESTIGATION_BOARD.BodyLabel"}}</label>
        <prose-mirror name="system.body" value="{{clue.body}}" toggled></prose-mirror>
    </div>
</section>
