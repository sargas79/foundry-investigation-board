{{!-- No name field here. Core's `page-header.hbs`, included by these sheets as
      `super.EDIT_PARTS.header`, already renders one. A second input with the same name makes
      `form.elements.namedItem("name")` a RadioNodeList, which FormDataExtended reads as an
      *array* of both values — so saving wrote "Old,New" and doubled the title on every edit. --}}
{{!--
    Context comes from DocumentSheetV2 (`document`, `rootId`, ...) and JournalEntryPageSheet
    (`name`, `title`, `uuid`). There is no `page` or `id` key — use `name` and `rootId`.
--}}
<section class="ib-clue-page-edit">
    <div class="form-group">
        <label for="{{rootId}}-template">{{localize "INVESTIGATION_BOARD.TemplateLabel"}}</label>
        <div class="form-fields">
            <select id="{{rootId}}-template" name="system.template">
                {{selectOptions templateChoices selected=clue.template}}
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="{{rootId}}-category">{{localize "INVESTIGATION_BOARD.CategoryLabel"}}</label>
        <div class="form-fields">
            <select id="{{rootId}}-category" name="system.category">
                {{selectOptions categoryChoices selected=clue.category}}
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="{{rootId}}-reliability">{{localize "INVESTIGATION_BOARD.ReliabilityLabel"}}</label>
        <div class="form-fields">
            <select id="{{rootId}}-reliability" name="system.reliability">
                {{selectOptions reliabilityChoices selected=clue.reliability}}
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="{{rootId}}-image">{{localize "INVESTIGATION_BOARD.ImageLabel"}}</label>
        <div class="form-fields">
            <file-picker id="{{rootId}}-image" type="image" name="system.image"
                         value="{{clue.image}}"></file-picker>
        </div>
    </div>

    <div class="form-group stacked">
        <label for="{{rootId}}-body">{{localize "INVESTIGATION_BOARD.BodyLabel"}}</label>
        <prose-mirror id="{{rootId}}-body" name="system.body" value="{{clue.body}}" toggled></prose-mirror>
    </div>
</section>
