{{!-- `name` comes from JournalEntryPageSheet's context; there is no `page` key. --}}
<section class="ib-report-page-view">
    <h2>{{name}}</h2>
    {{#if report.caseNumber}}
        <p class="ib-case-number">{{localize "INVESTIGATION_BOARD.CaseNumber"}}
            <strong>{{report.caseNumber}}</strong></p>
    {{/if}}
    <div class="ib-file-prose">{{{enrichedBody}}}</div>
</section>
